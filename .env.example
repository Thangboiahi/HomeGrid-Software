# Local-only Firebase Emulator Suite configuration. These demo values are not
# production Firebase credentials and must not be used with production services.
APP_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=demo-homegrid
FIREBASE_USE_EMULATORS=true

# Firebase Web SDK configuration. Firebase API keys and app IDs are public
# identifiers; never put private keys or service-account JSON in NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-homegrid.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-homegrid
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:homegrid-local
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# Admin SDK Emulator Suite endpoints. No Admin credentials are needed in this
# mode. Keep both host values protocol-free, as required by Firebase Admin.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional per-domain local outbox-worker limits. These are execution bounds,
# not credentials; omit them to use the same defaults shown here.
HOMEGRID_ACCOUNT_OUTBOX_MAX_CANDIDATES=100
HOMEGRID_ACCOUNT_OUTBOX_MAX_CLAIMS=20
HOMEGRID_ACCOUNT_OUTBOX_MAX_RUN_MS=45000
HOMEGRID_ACCOUNT_OUTBOX_MAX_PAGES=8
HOMEGRID_ACCOUNT_OUTBOX_PAGE_SIZE=25
HOMEGRID_ACCOUNT_OUTBOX_CONCURRENCY=2
HOMEGRID_ACCOUNT_OUTBOX_CLAIM_RESERVE_MS=2000
HOMEGRID_SESSION_OUTBOX_MAX_CANDIDATES=100
HOMEGRID_SESSION_OUTBOX_MAX_CLAIMS=20
HOMEGRID_SESSION_OUTBOX_MAX_RUN_MS=45000
HOMEGRID_SESSION_OUTBOX_MAX_PAGES=8
HOMEGRID_SESSION_OUTBOX_PAGE_SIZE=25
HOMEGRID_SESSION_OUTBOX_CONCURRENCY=2
HOMEGRID_SESSION_OUTBOX_CLAIM_RESERVE_MS=2000

# For non-emulator environments, use Application Default Credentials (ADC):
# - Local: run `gcloud auth application-default login`.
# - Cloud Run: attach a least-privilege runtime service identity.
# Optional local credential file path (outside this repository only):
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\homegrid-service-account.json
